{
    "version": 1,
    "environment": "staging",
    "api": {
        "host": "127.0.0.1",
        "port": 4000
    },
    "worker": {
        "host": "127.0.0.1",
        "port": 4001,
        "concurrency": 1
    },
    "web": {
        "host": "127.0.0.1",
        "port": 3000
    },
    "storage": {
        "kind": "postgres",
        "postgres": {
            "host": "127.0.0.1",
            "port": 5433,
            "database": "jarvis_staging",
            "runtimeUser": "jarvis_staging_runtime",
            "migratorUser": "jarvis_staging_migrator",
            "passwordRef": "staging/database/runtime",
            "migratorPasswordRef": "staging/database/migrator"
        },
        "encryptionKeyRef": "staging/storage/data-key",
        "objectStore": "disabled"
    },
    "events": {
        "transport": "redis",
        "host": "127.0.0.1",
        "port": 6380,
        "passwordRef": "staging/redis/runtime"
    },
    "models": {
        "providers": ["mock-a", "mock-b"],
        "allowCloud": false
    },
    "privacy": {
        "default": "local-only",
        "retainRequests": false
    },
    "memory": {
        "enabled": false,
        "temporaryTtlSeconds": 3600
    },
    "security": {
        "mode": "safe",
        "allowExternalActions": false,
        "authentication": "passkey",
        "requireAudit": true
    },
    "tools": {
        "enabled": false
    },
    "agents": {
        "enabled": false,
        "maxPersistentAgents": 0
    },
    "logging": {
        "level": "info",
        "includeContent": false
    },
    "identity": {
        "rpID": "localhost",
        "origin": "http://localhost:3000",
        "bootstrapRef": "staging/identity/bootstrap",
        "webTransportRef": "staging/identity/web-transport"
    },
    "devices": {
        "enrollmentEnabled": true
    },
    "budgets": {
        "maxRequestCost": 0
    },
    "rateLimits": {
        "requestsPerMinute": 120
    }
}
