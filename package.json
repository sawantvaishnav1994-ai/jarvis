{
    "name": "jarvis",
    "version": "0.3.0",
    "private": true,
    "type": "module",
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "packageManager": "npm@11.9.0",
    "engines": {
        "node": ">=24.13.0 <25",
        "npm": ">=11 <13"
    },
    "scripts": {
        "setup": "node scripts/setup.mjs",
        "start": "node scripts/start.mjs",
        "stop": "node scripts/stop.mjs",
        "infra:up": "node scripts/infrastructure.mjs up",
        "infra:down": "node scripts/infrastructure.mjs down",
        "secrets:init": "npm run build:packages && node scripts/secrets-init.mjs",
        "db:migrate": "npm run build:packages && node scripts/migrate.mjs",
        "build:packages": "tsc -b tsconfig.build.json",
        "build:web": "npm run build --workspace @jarvis/web",
        "build": "npm run build:packages && npm run build:web",
        "typecheck": "npm run build:packages && tsc -p tsconfig.tests.json && npm run typecheck --workspace @jarvis/web",
        "lint": "eslint packages apps tests scripts --ignore-pattern '**/dist/**' --ignore-pattern '**/.next/**' && node scripts/check-boundaries.mjs",
        "test": "npm run build:packages && vitest run",
        "test:integration": "npm run build:packages && vitest run --config vitest.integration.config.ts",
        "test:e2e": "playwright test",
        "smoke": "node scripts/smoke.mjs",
        "check": "npm run lint && npm run typecheck && npm test",
        "test:python": "PYTHONPATH=src .venv/bin/python -m unittest discover -s tests -v",
        "test:failures": "node scripts/failure-drill.mjs",
        "format": "prettier --write \"{apps,packages,config}/**/*.{ts,tsx,css,json}\" \"scripts/*.mjs\" \"tests/**/*.ts\" \"*.{json,mjs,ts}\"",
        "format:check": "prettier --check \"{apps,packages,config}/**/*.{ts,tsx,css,json}\" \"scripts/*.mjs\" \"tests/**/*.ts\" \"*.{json,mjs,ts}\""
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@playwright/test": "1.62.1",
        "@types/node": "24.13.3",
        "@types/pg": "8.23.1",
        "@types/react": "19.2.18",
        "@types/react-dom": "19.2.5",
        "eslint": "10.9.1",
        "prettier": "3.9.6",
        "typescript": "6.0.3",
        "typescript-eslint": "8.69.0",
        "vitest": "4.1.11"
    }
}
