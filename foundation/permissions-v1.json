{
    "version": 1,
    "levels": [
        {
            "id": "P0",
            "name": "Observe",
            "allowed": ["read-authorized-state", "inspect-authorized-audit"],
            "prohibited": ["prepare-side-effect", "execute-side-effect", "grant-authority"],
            "freshAuth": false,
            "approval": "none-beyond-session-policy",
            "delegation": "bounded-read-only",
            "emergencyEffect": "subject-to-all-emergency-controls"
        },
        {
            "id": "P1",
            "name": "Suggest",
            "allowed": ["P0", "generate-non-executing-suggestion"],
            "prohibited": ["execute-side-effect", "grant-authority"],
            "freshAuth": false,
            "approval": "none-beyond-session-policy",
            "delegation": "bounded-suggestion-only",
            "emergencyEffect": "subject-to-all-emergency-controls"
        },
        {
            "id": "P2",
            "name": "Prepare",
            "allowed": ["P1", "prepare-proposal", "prepare-draft"],
            "prohibited": ["execute-side-effect-without-governed-permit", "grant-authority"],
            "freshAuth": false,
            "approval": "required-before-sensitive-execution",
            "delegation": "bounded-prepare-only",
            "emergencyEffect": "subject-to-all-emergency-controls"
        },
        {
            "id": "P3",
            "name": "Execute Safe Actions",
            "allowed": ["P2", "execute-policy-classified-safe-action-through-gateway"],
            "prohibited": ["sensitive-action-without-step-up", "critical-owner-action", "grant-authority"],
            "freshAuth": "policy-dependent",
            "approval": "policy-dependent",
            "delegation": "recipient-and-scope-bound",
            "emergencyEffect": "blocked-or-reduced-by-emergency-policy"
        },
        {
            "id": "P4",
            "name": "Execute Sensitive Actions",
            "allowed": ["P3", "execute-sensitive-action-with-valid-fresh-approval-and-permit"],
            "prohibited": ["critical-owner-action-without-P5-conditions", "grant-authority-to-self"],
            "freshAuth": true,
            "approval": "required-and-one-shot-where-policy-requires",
            "delegation": "short-lived-recipient-bound-and-policy-limited",
            "emergencyEffect": "overridden-by-emergency-controls"
        },
        {
            "id": "P5",
            "name": "Critical Owner Actions",
            "allowed": ["P4", "critical-owner-action-with-privileged-device-and-fresh-owner-verification"],
            "prohibited": ["self-grant", "model-grant", "agent-grant", "tool-grant"],
            "freshAuth": true,
            "approval": "root-owner-controlled",
            "delegation": "not-implicitly-delegable",
            "emergencyEffect": "emergency-controls-remain-authoritative"
        }
    ],
    "globalRules": [
        "No model, agent, tool, service or integration may elevate its own permission level.",
        "Execution authority is produced by policy and authorization controls, never by model output.",
        "All tool execution remains gateway governed.",
        "Budgets, rate limits, device assurance, session freshness and security epochs may further restrict any level.",
        "Emergency controls may reduce or remove capability but never increase it."
    ]
}
